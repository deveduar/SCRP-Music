# SCRP Music — environment variables
# Copy to `.env` (local dev) or set them as env vars in your deployment platform.
# `.env` and `.env.local` are gitignored; `.env.example` is the committed reference.

# --- Server-side -------------------------------------------------------------
# Used by the CORS relay, both as a Vercel Serverless Function (api/relay.ts)
# and in the Docker/Node server (server/index.ts).
# Set to 'false' to disable the built-in relay on this deployment.
RELAY_ENABLED=true

# Port for the Docker/Node server (server/index.ts). Only used when self-hosting.
PORT=3000

# --- Client-side (baked at build time by Vite) -------------------------------
# Default CORS proxy used when the user has NOT configured a custom one in Settings.
# If unset, the app falls back to 'https://corsproxy.io/?'.
# Examples: https://corsproxy.io/?  |  https://api.allorigins.win/raw?url=
VITE_DEFAULT_PROXY=https://corsproxy.io/?

# Default API keys, baked at build time and seeded into Settings on FIRST run only.
# Once the user saves Settings (IndexedDB), those values win over these.
# Two formats (both optional):
#   1. JSON object, easiest for Docker build args:
#      VITE_DEFAULT_API_KEYS={"jamendo":"abc123"}
#   2. One var per adapter field (overrides the JSON above), good for dev/Vercel:
#      VITE_API_KEY_JAMENDO=abc123
# SECURITY: VITE_* vars end up in the client bundle, visible to anyone.
# Only use this for self-hosted/private instances or non-secret keys
# (e.g. Jamendo's public client_id). For public deployments, prefer the
# per-user "API Keys" section in Settings instead.
